<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light Mode) -->
    <style name="Base.Theme.Mozzic" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@color/page_background</item>
        <item name="android:navigationBarColor">@color/nav_bg_end</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Mozzic" parent="Base.Theme.Mozzic" />

    <!-- Bottom Nav Active Indicator (pill shape) -->
    <style name="BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/BottomNavIndicatorShape</item>
    </style>

    <style name="BottomNavIndicatorShape" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">16dp</item>
    </style>
</resources>