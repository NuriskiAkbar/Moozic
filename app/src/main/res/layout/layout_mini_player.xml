<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayerLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_mini_player"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:padding="10dp">

    <!-- Hidden YouTube Player (audio only) -->
    <FrameLayout
        android:id="@+id/youtube_container"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="visible"
        android:alpha="0">

        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
            android:id="@+id/miniyoutubeplayer"
            android:layout_width="1dp"
            android:layout_height="1dp" />

    </FrameLayout>

    <!-- Thumbnail Image -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/iv_mini_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="thumbnail" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Title & Singer -->
    <LinearLayout
        android:id="@+id/ll_title_singer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/tv_title_mini_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="title song"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_singer_mini_player"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="singer"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Play / Close Controls -->
    <LinearLayout
        android:id="@+id/ll_play_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_play_mini_player"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="play/pause"
            android:padding="6dp"
            android:src="@drawable/play"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/iv_close_mini_player"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="close"
            android:padding="6dp"
            android:src="@drawable/mingcute_close_fill"
            app:tint="#80FFFFFF" />

    </LinearLayout>

</LinearLayout>
